# This file is meant for local runtime configuration of the referral backend.
# app/core/config.py reads these values directly through Pydantic settings.

# Application settings
APP_NAME=Referral AI System
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama endpoint used for document classification and extraction prompts.
# When this host is unavailable, the backend falls back to OCR + rules where possible.
OLLAMA_URL=http://192.168.0.32:11434/api/generate
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_UNAVAILABLE_COOLDOWN_SECONDS=60

# Concurrency and pipeline safety
OCR_TIMEOUT_SECONDS=240
PIPELINE_TIMEOUT_SECONDS=600
OCR_CONCURRENCY=2
LLM_CONCURRENCY=2
BATCH_CONCURRENCY=4

# File handling safeguards
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_MEMBER_SIZE_MB=50
SPOOL_CHUNK_SIZE_BYTES=1048576
TEMP_DIRECTORY=uploads/tmp

# Decision thresholds
REVIEW_CONFIDENCE_THRESHOLD=0.72
LOW_CONFIDENCE_THRESHOLD=0.60
CLASSIFIER_DISAGREEMENT_THRESHOLD=0.35
OCR_POOR_QUALITY_THRESHOLD=0.55
RULE_REFERRAL_THRESHOLD=0.55
MIN_TEXT_ALPHA_CHARS_FOR_LLM=100
USE_RULE_GATE_FOR_LLM=false
RULE_LLM_GATE_THRESHOLD=0.20
LLM_REFERRAL_THRESHOLD=0.55
AGREEMENT_MIN_SCORE=0.65
CONSIDER_FOR_HUMAN_REVIEW=0.9

# Confidence fusion weights
OCR_WEIGHT=0.20
RULE_WEIGHT=0.20
LLM_WEIGHT=0.25
EXTRACTION_WEIGHT=0.20
VALIDATION_WEIGHT=0.15
