# This file is meant for local runtime configuration of the referral backend.
# Ollama endpoint used for document classification and extraction prompts.
# When this host is unavailable, the backend falls back to OCR + rules where possible.
OLLAMA_URL=http://192.168.0.32:11434/api/generate

# Ollama model name available on the target instance.
OLLAMA_MODEL=gemma4:e4b

# Optional overrides you can add here if you want behavior different from app/core/config.py defaults:
# OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_MAX_RETRIES=2
# OLLAMA_UNAVAILABLE_COOLDOWN_SECONDS=60
# OCR_CONCURRENCY=2
# LLM_CONCURRENCY=2
# BATCH_CONCURRENCY=4
# REVIEW_CONFIDENCE_THRESHOLD=0.72
# LOW_CONFIDENCE_THRESHOLD=0.60
# RULE_REFERRAL_THRESHOLD=0.55
# LLM_REFERRAL_THRESHOLD=0.55
